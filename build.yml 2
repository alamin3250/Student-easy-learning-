name: Build Android APK

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Flutter
        uses: subosito/flutter-action@v2
        with:
          flutter-version: "3.29.3"
          channel: stable

      - name: Extract project
        run: |
          mkdir app
          unzip student_easy_learning_flutter.zip -d app

      - name: Find Flutter project
        run: |
          find app -name pubspec.yaml -print

      - name: Build APK
        run: |
          PROJECT_DIR=$(dirname "$(find app -name pubspec.yaml -print -quit)")
          cd "$PROJECT_DIR"
          flutter pub get
          flutter build apk --release

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: student-easy-learning-apk
          path: "**/build/app/outputs/flutter-apk/app-release.apk"
